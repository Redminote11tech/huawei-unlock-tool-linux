# Maintainer: you <IamJupiterILY@proton.me>
#
# Local PKGBUILD: builds the Avalonia/.NET Linux port that lives in ../ (the
# `linux/` source tree). Run `makepkg -si` from this directory. Because it
# builds from the in-place source (not a downloaded tarball) and restores NuGet
# packages, it needs network access and is meant to be built WITHOUT a clean
# chroot (i.e. plain `makepkg`, not `extra-x86_64-build`).

pkgname=huawei-unlock-tool
pkgver=33F
pkgrel=1
pkgdesc="Huawei bootloader/FRP unlock + EDL/Kirin flashing tool (Linux port of werasik2aa's tool)"
arch=('x86_64')
url="https://github.com/werasik2aa/Huawei-Unlock-Tool"
license=('AGPL-3.0-or-later')
# Native libs the self-contained .NET build + Avalonia (X11 backend) need at runtime.
depends=('glibc' 'gcc-libs' 'zlib' 'icu' 'openssl' 'krb5' 'libusb'
         'fontconfig' 'libx11' 'libice' 'libsm' 'libxext' 'libxrandr'
         'libxi' 'libxcursor' 'libxrender' 'mesa')
makedepends=('dotnet-sdk')
optdepends=('emmcdl: Qualcomm EDL flashing helper (required for [QCOM] tabs)'
            'fh_loader: Qualcomm firehose flashing helper (required for [QCOM] tabs)')
options=('!strip')  # do not strip the bundled .NET native binaries
install="huawei-unlock-tool.install"

# Build from the sibling source tree (this PKGBUILD lives in linux/packaging).
_src="$startdir/.."

build() {
    export DOTNET_CLI_TELEMETRY_OPTOUT=1
    export DOTNET_NOLOGO=1
    export DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1

    dotnet publish "$_src/src/HuaweiUnlock.App/HuaweiUnlock.App.csproj" \
        -c Release \
        -r linux-x64 \
        --self-contained true \
        -p:PublishSingleFile=false \
        -p:DebugType=none \
        -o "$srcdir/publish"
}

package() {
    # App payload
    install -dm755 "$pkgdir/usr/lib/$pkgname"
    cp -a "$srcdir/publish/." "$pkgdir/usr/lib/$pkgname/"
    chmod 755 "$pkgdir/usr/lib/$pkgname/HuaweiUnlock"

    # Launcher
    install -Dm755 "$startdir/huawei-unlock-tool.sh" "$pkgdir/usr/bin/$pkgname"

    # Desktop entry + icon
    install -Dm644 "$startdir/huawei-unlock-tool.desktop" \
        "$pkgdir/usr/share/applications/$pkgname.desktop"
    install -Dm644 "$startdir/huawei-unlock-tool.png" \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/$pkgname.png"

    # udev rules — uaccess for EDL / Kirin fastboot / Huawei modes (no group/sudo)
    install -Dm644 "$startdir/51-huawei-unlock-tool.rules" \
        "$pkgdir/usr/lib/udev/rules.d/51-huawei-unlock-tool.rules"

    # License
    if [ -f "$_src/LICENSE" ]; then
        install -Dm644 "$_src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    fi
}
