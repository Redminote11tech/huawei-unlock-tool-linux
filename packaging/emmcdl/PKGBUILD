# Maintainer: you <IamJupiterILY@proton.me>
# emmcdl - Qualcomm Sahara/Firehose EDL command-line tool (Linux build).
# Same binary name and arguments as the Windows emmcdl.exe the tool shells out to.

pkgname=emmcdl
pkgver=r1
pkgrel=1
pkgdesc="Command-line utility for manipulating MSM devices in EDL mode (Sahara/Firehose)"
arch=('x86_64')
url="https://github.com/Zalexanninev15/emmcdl"
license=('BSD-3-Clause')
depends=('libusb' 'gcc-libs')
makedepends=('git' 'autoconf' 'automake' 'libtool' 'make' 'gcc')
provides=('emmcdl')
source=("git+https://github.com/Zalexanninev15/emmcdl.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/emmcdl"
    printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd "$srcdir/emmcdl"
    # Autotools bootstrap (per upstream): aclocal, autoconf, automake, configure, make.
    aclocal
    autoconf
    automake --add-missing --foreign
    ./configure --prefix=/usr
    make
}

package() {
    cd "$srcdir/emmcdl"
    # The build may or may not ship an install target; install the binary directly.
    install -Dm755 "$(find . -maxdepth 3 -type f -name emmcdl -perm -u+x | head -n1)" \
        "$pkgdir/usr/bin/emmcdl"
}
